    "Measure the longest side, the width, and the height in centimetres, including wheels and handles. Add the three numbers.": {
      "comment": "Help text explaining how to measure a bag.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車輪や取っ手を含めて、いちばん長い辺・幅・高さをセンチで測り、3つを足します。"
          }
        }
      }
    },
    "Measure your bag": {
      "comment": "Primary action to open baggage measurement.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "荷物を測る"
          }
        }
      }
    },
