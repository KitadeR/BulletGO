{
  "sourceLanguage": "en",
  "strings": {
    "A few details will help.": {
      "comment": "Fallback prompt when a question has no dedicated copy.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しだけ教えてください。"
          }
        }
      }
    },
    "Already booked": {
      "comment": "Choice for a purchased reservation.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約済み"
          }
        }
      }
    },
    "Answer a few questions": {
      "comment": "Fallback action when free text cannot be interpreted.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問に答える"
          }
        }
      }
    },
    "Are you bringing luggage?": {
      "comment": "Setup question prompt for luggage presence.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "荷物はありますか？"
          }
        }
