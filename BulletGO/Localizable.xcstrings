    "Baggage check": {
      "comment": "Feature hub title for checking oversized luggage rules.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "荷物の確認"
          }
        }
      }
    },
    "Based on JR Central oversized-baggage rules. 160 cm is the threshold; 161 cm needs a reserved space.": {
      "comment": "Official-source footnote under a baggage rule result.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JR東海の特大荷物ルールに基づきます。160cmが境目で、161cmから予約が必要です。"
          }
        }
      }
    },
    "Booking status": {
      "comment": "Summary heading for reservation status.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約の状況"
          }
        }
      }
    },
    "Check oversized luggage rules before you travel.": {
      "comment": "One-line explanation of baggage check.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特大荷物のルールを、乗る前に確認できます。"
