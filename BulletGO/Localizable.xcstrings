        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3辺の合計が160 cmを超え250 cm以内です。特大荷物スペースつき座席など、対応する座席の予約が必要です。"
          }
        }
      }
    },
